# Kopiere diese Datei zu .env und trage deinen Key ein.
# .env ist in .gitignore und landet nie im Repo.

# Gemini-API-Key von https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Modell überschreiben (Standard: gemini-3-flash-preview).
# Welche Modelle dein Key unterstützt, zeigt: node api/list-models.mjs
# GEMINI_MODEL=gemini-3-flash-preview
